# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai_study_assistant

# Security
JWT_SECRET=super_secret_jwt_key_study_assistant_development_2026
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Vector Search
VECTOR_SEARCH_TYPE=auto
